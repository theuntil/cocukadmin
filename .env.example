# ─────────────────────────────────────────────────────────────
#  ct-admin · Yönetim Paneli Ortam Değişkenleri
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://supabase.childrentribune.online
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SADECE SUNUCU — asla tarayıcıya sızmamalı
SUPABASE_SERVICE_ROLE_KEY=

# Ana sitenin adresi ("sitede gör" bağlantıları için)
# QR KODLARI
# Üretilen QR'lar bu adresi gösterir: <SITE_URL>/q/<kod>
# Panelin değil SİTENİN adresi olmalı — QR'ı okutan kişi siteye gider.
NEXT_PUBLIC_SITE_URL=https://cocuktribunu.org

# Bildirim servisi — aynı Docker ağındaysa konteyner adı
NOTIFY_SERVICE_URL=http://confirm-fejlhf-notify-1:8080
NOTIFY_SERVICE_SECRET=

# ── MAİL MODÜLÜ ──────────────────────────────────────────────
# SMTP ve IMAP bilgileri ENV'de DEĞİL, Mail → Ayarlar ekranında tutulur.
# Parolalar veritabanında; kod deposuna ya da env dosyasına girmez.
#
# Gelen postaları arka planda çeken ucu koruyan sır.
# TANIMLI DEĞİLSE UÇ KAPALIDIR.
#   curl -X POST https://admin.../api/mail/sync -H "authorization: Bearer $MAIL_CRON_SECRET"
#
# Zamanlama kurulmasa da sistem çalışır: panelde "Postaları al" düğmesi
# aynı işi yapar. Cron yalnızca kutunun kendiliğinden güncel kalması için
# (5 dakikada bir yeterli). Giden mail ANINDA gider, kuyruk yoktur.
MAIL_CRON_SECRET=

# Panelin genel adresi
NEXT_PUBLIC_ADMIN_URL=https://admin.childrentribune.online

# TAKIM PANELİ
# Davet bağlantıları bu adrese üretilir.
NEXT_PUBLIC_TEAM_URL=https://takim.cocuktribunu.org

# ── Cloudflare R2 (depolama) ──────────────────────────────────────
# Boş bırakılırsa Supabase Storage kullanılmaya devam eder.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Açık kova — özel alan adıyla sunulur
R2_BUCKET=cocuktribunu
# Kapalı kova — alan adı YOK, yalnızca sunucu erişir
R2_BUCKET_PRIVATE=cocuktribunu-ozel

# Açık kovanın özel alan adı. Boşsa okuma Supabase'den yapılır.
NEXT_PUBLIC_R2_PUBLIC_URL=https://medya.cocuktribunu.com

# ── GEÇİŞ ANAHTARLARI ────────────────────────────────────────────
#
# STORAGE_DUAL_WRITE
#   true  → yeni dosyalar HEM R2'ye HEM Supabase'e yazılır (geçiş dönemi)
#   false → YALNIZCA R2. Supabase'e hiç dokunulmaz.
#
#   Taşıma bitene kadar `true` bırakın: okumayı geri almanız
#   gerekirse dosyalar Supabase'de duruyor olur.
#   Her şey çalışıyorsa `false` yapın — asıl hedef bu.
STORAGE_DUAL_WRITE=true
STORAGE_READ_FROM=supabase

# ⚠️ İKİSİ DE AYNI DEĞERİ ALMALI.
#   STORAGE_READ_FROM        → sunucu (dosya indirme)
#   NEXT_PUBLIC_STORAGE_READ_FROM → tarayıcı (görsel adresleri)
# İkincisi derleme anında gömülür; değiştirince REBUILD gerekir.
NEXT_PUBLIC_STORAGE_READ_FROM=supabase
# Tarayıcı tarafı okuma. `publicStorageUrl` bunu okuyor ve öneksiz
# değişkenler tarayıcıya gitmediği için AYRI tanımlanmak zorunda.
# İkisi her zaman AYNI değeri almalı.
