# ─────────────────────────────────────────────────────────────────────────
#  ÇOCUK TRİBÜNÜ · .env.local
#  Bu dosyayı .env.local olarak kopyalayın. GİT'E EKLEMEYİN.
#  Değerler sizin Supabase kurulumunuza göre önceden dolduruldu.
# ─────────────────────────────────────────────────────────────────────────

# Supabase (self-hosted)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.childrentribune.online
NEXT_PUBLIC_SUPABASE_ANON_KEY=<.env dosyanızdaki ANON_KEY>

# SADECE SUNUCU — asla NEXT_PUBLIC_ yapmayın, asla tarayıcıya sızmamalı
SUPABASE_SERVICE_ROLE_KEY=<.env dosyanızdaki SERVICE_ROLE_KEY>

# Sitenizin adresi. Supabase'deki SITE_URL ve ADDITIONAL_REDIRECT_URLS
# değerleriyle AYNI alan adı olmalı, yoksa giriş sonrası dönüş çalışmaz.
NEXT_PUBLIC_SITE_URL=https://cocuktribunu.org

# Sosyal giriş — compose'da GOTRUE_EXTERNAL_*_ENABLED=true olanları yazın
NEXT_PUBLIC_OAUTH_PROVIDERS=google,apple

# Havale ekranında gösterilen banka bilgileri
NEXT_PUBLIC_BANK_NAME=Ziraat Bankası
NEXT_PUBLIC_BANK_HOLDER=Çocuk Tribünü Derneği
NEXT_PUBLIC_BANK_IBAN=TR00 0000 0000 0000 0000 0000 00

# Cloudflare Turnstile (imza ve bağış formu bot koruması) — boşsa doğrulama atlanır
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
